{
  "name": "deque-a11y-test-site",
  "private": true,
  "version": "1.0.0",
  "description": "Intentionally inaccessible test site and Storybook for accessibility testing with axe and Chromatic",
  "type": "module",
  "scripts": {
    "generate-data": "node scripts/generate-data.mjs",
    "serve": "npx --yes http-server . -p 8080 -c-1",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/html-vite": "^10.6.5",
    "chromatic": "^18.13.6",
    "storybook": "^10.6.5",
    "vite": "^8.3.5"
  }
}
